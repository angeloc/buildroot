/dts-v1/;

/ {
	description = "Luckfox Pico Mini B kernel and devicetree";
	#address-cells = <1>;

	images {
		kernel {
			description = "Linux kernel";
			data = /incbin/("zImage");
			type = "kernel";
			arch = "arm";
			os = "linux";
			compression = "none";
			load = <0x00800000>;
			entry = <0x00800000>;
			hash-1 {
				algo = "sha256";
			};
		};

		fdt {
			description = "Luckfox Pico Mini B devicetree";
			data = /incbin/("rv1103-luckfox-pico-mini-b.dtb");
			type = "flat_dt";
			arch = "arm";
			compression = "none";
			hash-1 {
				algo = "sha256";
			};
		};
	};

	configurations {
		default = "conf";

		conf {
			description = "Luckfox Pico Mini B";
			kernel = "kernel";
			fdt = "fdt";
		};
	};
};
