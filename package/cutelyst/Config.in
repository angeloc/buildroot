config BR2_PACKAGE_CUTELYST
	bool "cutelyst"
	depends on BR2_PACKAGE_QT6
	depends on BR2_TOOLCHAIN_GCC_AT_LEAST_11 # C++23, coroutines
	depends on BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_3
	select BR2_HOST_CMAKE_AT_LEAST_3_28
	select BR2_PACKAGE_HOST_QT6TOOLS
	select BR2_PACKAGE_HOST_QT6TOOLS_LINGUIST_TOOLS
	select BR2_PACKAGE_QT6BASE_NETWORK
	select BR2_PACKAGE_QT6BASE_SQL
	help
	  A C++ Web Framework built on top of Qt, using
	  the simple approach of Catalyst (Perl) framework.

	  https://cutelyst.org

comment "cutelyst needs a toolchain w/ gcc >= 11, headers >= 3.3"
	depends on BR2_PACKAGE_QT6
	depends on !BR2_TOOLCHAIN_GCC_AT_LEAST_11 || \
		!BR2_TOOLCHAIN_HEADERS_AT_LEAST_3_3
