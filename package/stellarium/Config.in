config BR2_PACKAGE_STELLARIUM
	bool "stellarium"
	depends on BR2_PACKAGE_QT6
	depends on BR2_PACKAGE_QT6_GL_SUPPORTS
	depends on BR2_PACKAGE_HAS_LIBGL # does not support OpenGL ES
	select BR2_PACKAGE_QT6BASE_CONCURRENT
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_NETWORK
	select BR2_PACKAGE_QT6BASE_OPENGL
	select BR2_PACKAGE_QT6BASE_PRINTSUPPORT
	select BR2_PACKAGE_QT6BASE_WIDGETS
	select BR2_PACKAGE_QT6CHARTS
	select BR2_PACKAGE_QT6MULTIMEDIA
	select BR2_PACKAGE_QT6POSITIONING
	select BR2_PACKAGE_QT6SVG
	select BR2_PACKAGE_ZLIB
	help
	  Stellarium is a free open source planetarium for your
	  computer. It shows a realistic sky in 3D, just like what
	  you see with the naked eye, binoculars or a telescope.

	  https://stellarium.org

comment "stellarium needs Qt6 and an OpenGL provider"
	depends on !BR2_PACKAGE_QT6 || !BR2_PACKAGE_HAS_LIBGL
