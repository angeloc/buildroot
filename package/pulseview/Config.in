config BR2_PACKAGE_PULSEVIEW
	bool "pulseview"
	depends on BR2_PACKAGE_QT6
	depends on BR2_TOOLCHAIN_SUPPORTS_ALWAYS_LOCKFREE_ATOMIC_INTS # boost-filesystem
	depends on BR2_ENABLE_LOCALE # libsigrok
	select BR2_PACKAGE_BOOST
	select BR2_PACKAGE_BOOST_FILESYSTEM
	select BR2_PACKAGE_BOOST_SERIALIZATION
	select BR2_PACKAGE_BOOST_SYSTEM
	select BR2_PACKAGE_HOST_QT6TOOLS
	select BR2_PACKAGE_HOST_QT6TOOLS_LINGUIST_TOOLS
	select BR2_PACKAGE_LIBSIGROK
	select BR2_PACKAGE_LIBSIGROKCXX
	select BR2_PACKAGE_QT6BASE_GUI
	select BR2_PACKAGE_QT6BASE_PNG
	select BR2_PACKAGE_QT6BASE_WIDGETS
	select BR2_PACKAGE_QT6SVG
	help
	  PulseView is a Qt based logic analyzer, oscilloscope
	  and MSO GUI for sigrok.

	  http://sigrok.org/wiki/PulseView

comment "pulseview needs a toolchain w/ locale"
	depends on BR2_PACKAGE_QT6
	depends on BR2_TOOLCHAIN_SUPPORTS_ALWAYS_LOCKFREE_ATOMIC_INTS
	depends on !BR2_ENABLE_LOCALE
