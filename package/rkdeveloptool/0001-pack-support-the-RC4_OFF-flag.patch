From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Angelo Compagnucci <angelo.compagnucci@gmail.com>
Date: Mon, 2 Nov 2026 18:05:51 +0100
Subject: [PATCH] pack: support the RC4_OFF flag

Recent Rockchip SoCs, like the RV1106, need the code downloaded in
USB maskrom mode (471 and 472 entries) without RC4 encryption: the
boot merger configuration files for these SoCs in rkbin set
RC4_OFF=true in a [FLAG] section, along with a [SYSTEM] section, which
make the pack command fail.

Parse the [SYSTEM] and [FLAG] sections, and store the 471 and 472
entries without RC4 encryption when RC4_OFF=true, as the rkbin boot
merger does.

Upstream: https://github.com/rockchip-linux/rkdeveloptool/pull/135
Signed-off-by: Angelo Compagnucci <angelo.compagnucci@gmail.com>
---
 boot_merger.h |  4 ++++
 main.cpp      | 40 +++++++++++++++++++++++++++++++++++++++-
 2 files changed, 43 insertions(+), 1 deletion(-)

diff --git a/boot_merger.h b/boot_merger.h
index b51142f..b739228 100755
--- a/boot_merger.h
+++ b/boot_merger.h
@@ -47,6 +47,8 @@ typedef char line_t[MAX_LINE_LEN];
 #define SEC_472             "[CODE472_OPTION]"
 #define SEC_LOADER          "[LOADER_OPTION]"
 #define SEC_OUT             "[OUTPUT]"
+#define SEC_SYSTEM          "[SYSTEM]"
+#define SEC_FLAG            "[FLAG]"
 
 #define OPT_NAME            "NAME"
 #define OPT_MAJOR           "MAJOR"
@@ -57,6 +59,7 @@ typedef char line_t[MAX_LINE_LEN];
 #define OPT_SLEEP           "Sleep"
 #define OPT_LOADER_NAME     "LOADER"
 #define OPT_OUT_PATH        "PATH"
+#define OPT_RC4_OFF         "RC4_OFF"
 
 typedef struct {
 	char       name[MAX_LINE_LEN];
@@ -76,6 +79,7 @@ typedef struct {
 	int         loaderNum;
 	name_entry* loader;
 	char        outPath[MAX_LINE_LEN];
+	bool        rc4Off;
 } options;
 
 
diff --git a/main.cpp b/main.cpp
index 42bfbab..641d770 100644
--- a/main.cpp
+++ b/main.cpp
@@ -1173,6 +1173,37 @@ static bool parseLoader(FILE* file) {
 	return true;
 }
 
+/*
+ * Parse the [SYSTEM] and [FLAG] sections of the Rockchip boot merger
+ * configuration files: only RC4_OFF is supported, to store the entries
+ * without RC4 encryption, as needed by the recent SoCs (e.g. RV1106).
+ */
+static bool parseFlags(FILE* file) {
+	char buf[MAX_LINE_LEN];
+	long pos;
+
+	while (1) {
+		long eat = ftell(file);
+
+		if (SCANF_EAT(file) != 0)
+			return false;
+		pos = ftell(file);
+		if (fscanf(file, "%s", buf) != 1) {
+			/* Leave the trailing blanks to the caller */
+			fseek(file, eat, SEEK_SET);
+			return true;
+		}
+		if (buf[0] == '[') {
+			fseek(file, pos, SEEK_SET);
+			return true;
+		}
+		if (!strcmp(buf, OPT_RC4_OFF "=true")) {
+			gOpts.rc4Off = true;
+			printf("rc4 off\n");
+		}
+	}
+}
+
 static bool parseOut(FILE* file) {
 	if (SCANF_EAT(file) != 0) {
 		return false;
@@ -1283,6 +1314,11 @@ static bool parseOpts(void) {
 				printf("parseOut failed!\n");
 				goto end;
 			}
+		} else if (!strcmp(buf, SEC_SYSTEM) || !strcmp(buf, SEC_FLAG)) {
+			if (!parseFlags(file)) {
+				printf("parseFlags failed!\n");
+				goto end;
+			}
 		} else if (buf[0] == '#') {
 			continue;
 		} else {
@@ -1323,6 +1359,7 @@ bool initOpts(void) {
 	strcpy(gOpts.loader[1].name, DEF_LOADER1);
 	strcpy(gOpts.loader[1].path, DEF_LOADER1_PATH);
 	strcpy(gOpts.outPath, DEF_OUT_PATH);
+	gOpts.rc4Off = false;
 
 	return parseOpts();
 }
@@ -1447,7 +1484,8 @@ static bool writeFile(FILE* outFile, const char* path, bool fix) {
 		uint32_t tmp = size % ENTRY_ALIGN;
 		tmp = tmp ? (ENTRY_ALIGN - tmp): 0;
 		size +=tmp;
-		P_RC4(gBuf, size);
+		if (!gOpts.rc4Off)
+			P_RC4(gBuf, size);
 	}
 
 	if (!fwrite(gBuf, size, 1, outFile))
-- 
2.34.1

