config BR2_PACKAGE_KF6_NETWORKMANAGER_QT
	bool "kf6-networkmanager-qt"
	depends on BR2_PACKAGE_NETWORK_MANAGER
	select BR2_PACKAGE_KF6_EXTRA_CMAKE_MODULES
	select BR2_PACKAGE_QT6BASE_DBUS
	select BR2_PACKAGE_QT6BASE_NETWORK
	select BR2_PACKAGE_QT6DECLARATIVE
	help
	  KF6 is a set of Qt framework addons, extending Qt in various
	  ways, not only restricted in helping integration in KDE.

	  This package contains the NetworkManager Qt6 bindings from
	  the KF6 project.

	  https://api.kde.org/networkmanager-qt-index.html
