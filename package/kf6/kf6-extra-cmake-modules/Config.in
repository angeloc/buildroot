config BR2_PACKAGE_KF6_EXTRA_CMAKE_MODULES
	bool "kf6-extra-cmake-modules"
	select BR2_HOST_CMAKE_AT_LEAST_3_30
	help
	  KF6 is a set of Qt framework addons, extending Qt in various
	  ways, not only restricted in helping integration in KDE.

	  This package corresponds to the extra CMake modules,
	  required for most KF6 libraries.

	  https://api.kde.org/ecm/
